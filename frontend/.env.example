# API Base URL (Optional in local dev proxy mode, set to your deployed backend API URL in production on Netlify)
# Example: VITE_API_BASE_URL=https://setu-backend.onrender.com/api
# If left unset or set to /api, it will use relative path /api
VITE_API_BASE_URL=/api

# Firebase Configuration (Replace with your Firebase project credentials)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

